/**
 * Regenerates `src/runtime/codex-protocol.generated.ts` from the INSTALLED Codex CLI (`codex app-server generate-ts`), so
 * the adapter's protocol types are never invented. Only the transitive closure of the types the adapter uses is kept, in
 * one file with the generator version pinned. Usage: `node generate-codex-protocol.mts` (needs `codex` on PATH, or `CODEX_BIN`).
 */
import * as fs from 'node:fs/promises';
import * as os from 'node:os';
import * as path from 'node:path';
import { execFileSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const ROOTS = [
	'InitializeParams', 'InitializeResponse',
	'v2/ThreadStartParams', 'v2/ThreadStartResponse', 'v2/ThreadResumeParams', 'v2/ThreadResumeResponse', 'v2/ThreadForkParams', 'v2/ThreadForkResponse',
	'v2/ThreadReadParams', 'v2/ThreadReadResponse', 'v2/TurnStartParams', 'v2/TurnStartResponse', 'v2/TurnSteerParams', 'v2/TurnSteerResponse', 'v2/TurnInterruptParams',
	'v2/CommandExecutionRequestApprovalParams', 'v2/CommandExecutionRequestApprovalResponse', 'v2/FileChangeRequestApprovalParams', 'v2/FileChangeRequestApprovalResponse',
	'v2/PermissionsRequestApprovalParams', 'v2/PermissionsRequestApprovalResponse', 'v2/ToolRequestUserInputParams', 'v2/ToolRequestUserInputResponse',
	'v2/McpServerElicitationRequestResponse',
	'v2/TurnStartedNotification', 'v2/TurnCompletedNotification', 'v2/ItemStartedNotification', 'v2/ItemCompletedNotification', 'v2/AgentMessageDeltaNotification',
	'v2/CommandExecutionOutputDeltaNotification', 'v2/ThreadTokenUsageUpdatedNotification', 'v2/ErrorNotification', 'v2/ThreadStatusChangedNotification'
];

const here = path.dirname(fileURLToPath(import.meta.url));
const target = path.join(here, 'src', 'runtime', 'codex-protocol.generated.ts');
const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'codex-ts-'));
const shell = process.platform === 'win32';
/** `CODEX_BIN` points at a specific CLI (for example a newer release unpacked for validation) instead of the one on PATH. */
const codex = process.env.CODEX_BIN ?? 'codex';
try {
	const version = execFileSync(codex, ['--version'], { encoding: 'utf8', shell }).trim();
	execFileSync(codex, ['app-server', 'generate-ts', '--out', temporary], { stdio: 'ignore', shell });
	const files = new Map<string, string>();
	const queue = [...ROOTS];
	while (queue.length) {
		const name = queue.shift()!;
		if (files.has(path.basename(name))) { continue; }
		const source = await fs.readFile(path.join(temporary, name + '.ts'), 'utf8');
		const directory = path.dirname(name);
		const body: string[] = [];
		for (const line of source.split('\n')) {
			const imported = /^import type \{ (?<type>\w+) \} from "(?<from>[^"]+)";/.exec(line);
			if (imported) { queue.push(path.posix.normalize(path.posix.join(directory, imported.groups!.from))); continue; }
			if (line.startsWith('// ')) { continue; }
			body.push(line);
		}
		const text = body.join('\n').trim();
		if (files.has(path.basename(name)) && files.get(path.basename(name)) !== text) { throw Error('CODEX_PROTOCOL_NAME_CLASH: ' + name); }
		files.set(path.basename(name), text);
	}
	const header = [
		'/*---------------------------------------------------------------------------------------------',
		' *  Copyright (c) Microsoft Corporation. All rights reserved.',
		' *  Licensed under the MIT License. See License.txt in the project root for license information.',
		' *--------------------------------------------------------------------------------------------*/',
		'/* eslint-disable */',
		'// GENERATED by generate-codex-protocol.mts from `codex app-server generate-ts`. Do not edit by hand.',
		'',
		'export const CODEX_PROTOCOL_VERSION = ' + JSON.stringify(version.replace(/^codex-cli\s+/, '')) + ';',
		''
	];
	const body = [...files.keys()].sort().map(name => files.get(name)!);
	await fs.writeFile(target, header.join('\n') + '\n' + body.join('\n\n') + '\n');
	console.log('wrote ' + files.size + ' types for ' + version + ' to ' + path.relative(here, target));
} finally {
	await fs.rm(temporary, { recursive: true, force: true });
}
