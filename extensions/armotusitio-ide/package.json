{
  "name": "armotusitio-ide",
  "displayName": "ArmotuSitio IDE",
  "description": "Project-aware harness control for RedEvent and ArmoTuSitio 2.0",
  "version": "0.5.0",
  "publisher": "armotusitio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.143.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:atsHarness.tasks",
    "onCommand:atsHarness.execute",
    "onCommand:atsHarness.cancelTask",
    "onCommand:atsHarness.reviewPlan",
    "onCommand:atsIde.worktrees",
    "onCommand:atsIde.createWorktree",
    "onCommand:atsIde.context",
    "onCommand:atsIde.github",
    "onCommand:atsIde.n8n",
    "onCommand:atsIde.agent",
    "onStartupFinished"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "atsIde.harness",
        "name": "harness",
        "fullName": "ArmotuSitio Harness",
        "description": "Harness local y Work Management de ArmotuSitio, sin llamadas a modelos de IA.",
        "commands": [
          { "name": "estado", "description": "Consultar el progreso y el historial del Harness" },
          { "name": "comandos", "description": "Listar comandos de los proyectos abiertos" },
          { "name": "check", "description": "Confirmar e iniciar check [armotusitio o redevent]" },
          { "name": "verify", "description": "Confirmar e iniciar verify [armotusitio o redevent]" },
          { "name": "test", "description": "Confirmar e iniciar test [armotusitio o redevent]" },
          { "name": "mcp", "description": "Consultar la conexión y las herramientas del MCP" },
          { "name": "proyectos", "description": "Listar proyectos de Work Management" },
          { "name": "tareas", "description": "Listar tareas de un proyecto" },
          { "name": "tarea", "description": "Obtener contexto de una tarea por su clave" },
          { "name": "crear", "description": "Crear una tarea con confirmación" },
          { "name": "mover", "description": "Cambiar de columna una tarea con confirmación" },
          { "name": "comentar", "description": "Agregar un comentario con confirmación" }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      { "id": "atsIde.armotusitioMcp", "label": "ArmotuSitio Work Management" }
    ],
    "configuration": {
      "title": "ArmoTuSitio Harness",
      "properties": {
        "atsHarness.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Conectar el MCP de Work Management de ArmotuSitio. Requiere workspace confiable y clave de agente."
        },
        "atsHarness.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable workspace-local harness detection."
        },
        "atsHarness.notifications": {
          "type": "string",
          "enum": ["always", "errors", "never"],
          "enumDescriptions": [
            "Avisar cuando una tarea del IDE termina, falla o se cancela.",
            "Avisar solo ante errores o cuando no se conoce el código de salida.",
            "No mostrar notificaciones al finalizar tareas del IDE."
          ],
          "default": "errors",
          "scope": "resource",
          "description": "Notificaciones al finalizar tareas del Harness iniciadas desde el IDE. Incluyen la duración y acceso al historial."
        },
        "atsHarness.n8nUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5678",
          "description": "The URL of your trusted n8n dashboard. Credentials must not be embedded in this setting."
        },
        "atsHarness.showWelcome": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar el inicio de ArmotuSitio IDE al abrir una ventana sin editores."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atsHarness",
          "title": "ArmoTuSitio",
          "icon": "resources/ats.svg"
        }
      ]
    },
    "views": {
      "atsHarness": [
        {
          "id": "atsHarness.tasks",
          "name": "Harness & Agents"
        }
      ]
    },
    "commands": [
      { "command": "atsHarness.nativeSupport", "title": "ArmoTuSitio: Diagnósticos y evidencias del Harness nativo" },
      { "command": "atsHarness.nativeAgentReview", "title": "ArmoTuSitio: Revisar propuesta de agente nativo" },
      { "command": "atsHarness.nativeConfigure", "title": "ArmoTuSitio: Configurar Harness nativo del proyecto" },
      { "command": "atsHarness.nativeDoctor", "title": "ArmoTuSitio: Diagnóstico del Harness nativo" },
      { "command": "atsHarness.nativeNewTask", "title": "ArmoTuSitio: Crear tarea nativa" },
      { "command": "atsHarness.nativeRunTask", "title": "ArmoTuSitio: Ejecutar tarea nativa" },
      { "command": "atsHarness.nativeStatus", "title": "ArmoTuSitio: Estado de tareas nativas" },
      { "command": "atsHarness.nativeReconcile", "title": "ArmoTuSitio: Reconciliar estado nativo" },
      { "command": "atsHarness.nativeCancel", "title": "ArmoTuSitio: Cancelar tarea nativa" },
      { "command": "atsHarness.selectProvider", "title": "ArmotuSitio: Elegir IA del Harness", "icon": "$(hubot)" },
      { "command": "atsIde.chat", "title": "ArmotuSitio: Chat Harness", "icon": "$(comment-discussion)" },
      { "command": "atsIde.mcpConfigure", "title": "ArmotuSitio: Configurar clave MCP" },
      { "command": "atsIde.mcpClearKey", "title": "ArmotuSitio: Borrar clave MCP guardada" },
      { "command": "atsHarness.history", "title": "ArmotuSitio: Historial del Harness" },
      { "command": "atsHarness.clearHistory", "title": "ArmotuSitio: Borrar historial del Harness" },
      {
        "command": "atsHarness.taskActions",
        "title": "ArmotuSitio: Abrir Tarea del Harness"
      },
      {
        "command": "atsIde.home",
        "title": "ArmotuSitio: Inicio",
        "icon": "$(home)"
      },
      {
        "command": "atsHarness.refresh",
        "title": "ArmoTuSitio: Refresh Projects"
      },
      {
        "command": "atsHarness.execute",
        "title": "ArmoTuSitio: Execute Harness Command"
      },
      {
        "command": "atsHarness.cancelTask",
        "title": "ArmoTuSitio: Cancel Running Task"
      },
      {
        "command": "atsHarness.reviewPlan",
        "title": "ArmoTuSitio: Validate Agent Plan"
      },
      {
        "command": "atsHarness.check",
        "title": "ArmoTuSitio: check"
      },
      {
        "command": "atsHarness.status",
        "title": "ArmoTuSitio: status"
      },
      {
        "command": "atsHarness.run",
        "title": "ArmoTuSitio: run"
      },
      {
        "command": "atsIde.worktrees",
        "title": "ArmoTuSitio: Inspect Git Worktrees"
      },
      {
        "command": "atsIde.createWorktree",
        "title": "ArmoTuSitio: Create Git Worktree"
      },
      {
        "command": "atsIde.context",
        "title": "ArmoTuSitio: Inspect Project Context"
      },
      {
        "command": "atsIde.github",
        "title": "ArmoTuSitio: GitHub Actions and PRs"
      },
      {
        "command": "atsIde.n8n",
        "title": "ArmoTuSitio: Open n8n Dashboard"
      },
      {
        "command": "atsIde.agent",
        "title": "ArmoTuSitio: Run Claude or Codex"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "atsHarness.selectProvider", "when": "view == atsHarness.tasks", "group": "navigation@2" },
        { "command": "atsIde.chat", "when": "view == atsHarness.tasks", "group": "navigation@1" },
        {
          "command": "atsIde.home",
          "when": "view == atsHarness.tasks",
          "group": "navigation@0"
        },
        {
          "command": "atsHarness.refresh",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        },
        {
          "command": "atsHarness.cancelTask",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        },
        {
          "command": "atsHarness.reviewPlan",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        { "command": "atsHarness.selectProvider", "when": "view == atsHarness.tasks && viewItem == atsHarness.project", "group": "inline" }
      ]
    },
    "themes": [
      {
        "label": "ArmoTuSitio Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/armotusitio-dark-color-theme.json"
      },
      {
        "label": "ArmoTuSitio Light",
        "uiTheme": "vs",
        "path": "./themes/armotusitio-light-color-theme.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "atsHarness.tasks",
        "contents": "[Abrir inicio de ArmotuSitio IDE](command:atsIde.home)"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "ArmoTuSitio Dark"
    }
  },
  "scripts": {
    "compile": "node esbuild.mts",
    "test": "node --test test/*.test.cts",
    "check": "node ../../node_modules/@typescript/native/bin/tsc --project tsconfig.json && node check-resources.mts",
    "vscode:prepublish": "npm run compile"
  },
  "icon": "resources/logo.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "La ejecución de comandos requiere un workspace confiable."
    }
  }
}
