{
  "name": "armotusitio-ide",
  "displayName": "ArmoTuSitio IDE",
  "description": "Dual-project Harness integration for ArmoTuSitio 2.0 and RedEvent",
  "version": "0.1.0",
  "publisher": "armotusitio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:atsHarness.tasks",
    "onCommand:atsHarness.execute",
    "onCommand:atsHarness.openPlan"
  ],
  "contributes": {
    "configuration": {
      "title": "ArmoTuSitio Harness",
      "properties": {
        "atsHarness.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable workspace-local harness detection."
        },
        "atsHarness.confirmExecution": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before running a workspace harness command."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atsHarness",
          "title": "ArmoTuSitio",
          "icon": "resources/ats.svg"
        }
      ]
    },
    "views": {
      "atsHarness": [
        {
          "id": "atsHarness.tasks",
          "name": "Harness & Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "atsHarness.refresh",
        "title": "ArmoTuSitio: Refresh Projects"
      },
      {
        "command": "atsHarness.execute",
        "title": "ArmoTuSitio: Execute Harness Command"
      },
      {
        "command": "atsHarness.openPlan",
        "title": "ArmoTuSitio: Review Agent Plan"
      },
      {
        "command": "atsHarness.check",
        "title": "ArmoTuSitio: Harness check"
      },
      {
        "command": "atsHarness.status",
        "title": "ArmoTuSitio: Harness status"
      },
      {
        "command": "atsHarness.run",
        "title": "ArmoTuSitio: Harness run"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atsHarness.refresh",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        },
        {
          "command": "atsHarness.openPlan",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        }
      ]
    },
    "themes": [
      {
        "label": "ArmoTuSitio Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/armotusitio-dark-color-theme.json"
      }
    ]
  }
}
