{
  "name": "armotusitio-ide",
  "displayName": "ArmotuSitio IDE",
  "description": "Project-aware harness control for RedEvent and ArmoTuSitio 2.0",
  "version": "0.3.0",
  "publisher": "armotusitio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:atsHarness.tasks",
    "onCommand:atsHarness.execute",
    "onCommand:atsHarness.cancelTask",
    "onCommand:atsHarness.reviewPlan",
    "onCommand:atsIde.worktrees",
    "onCommand:atsIde.createWorktree",
    "onCommand:atsIde.context",
    "onCommand:atsIde.github",
    "onCommand:atsIde.n8n",
    "onCommand:atsIde.agent",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "ArmoTuSitio Harness",
      "properties": {
        "atsHarness.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable workspace-local harness detection."
        },
        "atsHarness.n8nUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5678",
          "description": "The URL of your trusted n8n dashboard. Credentials must not be embedded in this setting."
        },
        "atsHarness.showWelcome": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar el inicio de ArmotuSitio IDE al abrir una ventana sin editores."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atsHarness",
          "title": "ArmoTuSitio",
          "icon": "resources/ats.svg"
        }
      ]
    },
    "views": {
      "atsHarness": [
        {
          "id": "atsHarness.tasks",
          "name": "Harness & Agents"
        }
      ]
    },
    "commands": [
      { "command": "atsHarness.history", "title": "ArmotuSitio: Historial del Harness" },
      { "command": "atsHarness.clearHistory", "title": "ArmotuSitio: Borrar historial del Harness" },
      {
        "command": "atsIde.home",
        "title": "ArmotuSitio: Inicio",
        "icon": "$(home)"
      },
      {
        "command": "atsHarness.refresh",
        "title": "ArmoTuSitio: Refresh Projects"
      },
      {
        "command": "atsHarness.execute",
        "title": "ArmoTuSitio: Execute Harness Command"
      },
      {
        "command": "atsHarness.cancelTask",
        "title": "ArmoTuSitio: Cancel Running Task"
      },
      {
        "command": "atsHarness.reviewPlan",
        "title": "ArmoTuSitio: Validate Agent Plan"
      },
      {
        "command": "atsHarness.check",
        "title": "ArmoTuSitio: check"
      },
      {
        "command": "atsHarness.status",
        "title": "ArmoTuSitio: status"
      },
      {
        "command": "atsHarness.run",
        "title": "ArmoTuSitio: run"
      },
      {
        "command": "atsIde.worktrees",
        "title": "ArmoTuSitio: Inspect Git Worktrees"
      },
      {
        "command": "atsIde.createWorktree",
        "title": "ArmoTuSitio: Create Git Worktree"
      },
      {
        "command": "atsIde.context",
        "title": "ArmoTuSitio: Inspect Project Context"
      },
      {
        "command": "atsIde.github",
        "title": "ArmoTuSitio: GitHub Actions and PRs"
      },
      {
        "command": "atsIde.n8n",
        "title": "ArmoTuSitio: Open n8n Dashboard"
      },
      {
        "command": "atsIde.agent",
        "title": "ArmoTuSitio: Run Claude or Codex"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "atsIde.home",
          "when": "view == atsHarness.tasks",
          "group": "navigation@0"
        },
        {
          "command": "atsHarness.refresh",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        },
        {
          "command": "atsHarness.cancelTask",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        },
        {
          "command": "atsHarness.reviewPlan",
          "when": "view == atsHarness.tasks",
          "group": "navigation"
        }
      ]
    },
    "themes": [
      {
        "label": "ArmoTuSitio Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/armotusitio-dark-color-theme.json"
      },
      {
        "label": "ArmoTuSitio Light",
        "uiTheme": "vs",
        "path": "./themes/armotusitio-light-color-theme.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "atsHarness.tasks",
        "contents": "[Abrir inicio de ArmotuSitio IDE](command:atsIde.home)"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "ArmoTuSitio Dark"
    }
  },
  "scripts": {
    "compile": "node esbuild.mts",
    "test": "node --test test/*.test.cts",
    "check": "node ../../node_modules/@typescript/native/bin/tsc --project tsconfig.json && node --check resources/home.ts",
    "vscode:prepublish": "npm run compile"
  },
  "icon": "resources/logo.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "La ejecución de comandos requiere un workspace confiable."
    }
  }
}
