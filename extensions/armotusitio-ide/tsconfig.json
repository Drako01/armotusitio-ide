{
	"compilerOptions": {
		"target": "ES2024",
		"module": "CommonJS",
		"moduleDetection": "force",
		"types": [
			"node"
		],
		"typeRoots": [
			"../../node_modules/@types"
		],
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"allowImportingTsExtensions": true
	},
	"include": [
		"extension.ts",
		"src/**/*.ts"
	]
}
