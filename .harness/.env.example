# RedEvent Harness local configuration
# Copy this file to .harness/.env. The .env file is intentionally ignored by Git.
# Variables already exported by the shell take precedence over values in this file.

# Agent host: codex | claude
HARNESS_HOST=codex

# Optional custom/fallback agent command. Leave unset unless explicitly needed.
# HARNESS_AGENT_COMMAND=

# Execution controls (current Harness defaults shown).
HARNESS_AGENT_TIMEOUT_MS=3600000
HARNESS_GATE_TIMEOUT_MS=3600000
HARNESS_MAX_RETRIES=3

# Optional Claude Code settings.
# HARNESS_CLAUDE_MODEL=
# HARNESS_CLAUDE_MAX_TURNS=

# Optional explicit Codex model; unset uses the CLI default.
# HARNESS_CODEX_MODEL=

# Optional compatible interpreter path; fallback provisions pinned local Python automatically.
# HARNESS_PYTHON=

# Conservative local context estimates; budgets never increase automatically.
HARNESS_CONTEXT_BUDGET=16000
HARNESS_TASK_BUDGET=16000

# Set to 1 to print Harness stack traces on failures.
HARNESS_DEBUG=0

# Emergency/manual operator override for the Claude orchestrator write guard.
# Keep disabled during normal Harness operation.
HARNESS_ALLOW_HOST_WRITES=0

# Ejecución paralela. Si NO definís HARNESS_MAX_WORKERS, el Harness calcula los workers del plan de cada tarea
# (ancho del DAG, tope policies.json parallel.autoMaxWorkers=8) y sube los límites de rol/host a ese valor: una tarea
# chica usa 1 worker, una extensa hasta 8. Definirlo fija el máximo y manda sobre el cálculo. 1 = ejecutor secuencial.
# Valores recomendados para una máquina holgada:
HARNESS_MAX_WORKERS=8
HARNESS_HOST_LIMIT=8
HARNESS_ROLE_LIMITS=backend=4,backoffice=4,documentation=3,tester=4,infra=3
# HARNESS_PARALLEL=0
# HARNESS_PLANNER=auto
# HARNESS_MIN_SPEEDUP=1.2
# Absolute path for isolated worktrees (default: system temp dir, outside the repository).
# HARNESS_WORKTREE_DIR=
# Whole-run wall limit in ms (0 = none).
# HARNESS_TASK_TIMEOUT_MS=0

# Aislamiento de pruebas: con 1 el Harness NO lee este archivo (harness:test lo activa solo).
# HARNESS_IGNORE_ENV_FILE=0
# Preflight obligatorio en harness:run para tareas no triviales (off = omitirlo; preferí `--no-preflight`).
# HARNESS_PREFLIGHT=on
# Reuso de gates ya en verde sobre el mismo árbol y reintento único de flakes conocidos (0 = desactivar).
# HARNESS_GATE_CACHE=1

# Mejoras recientes (todas con default seguro; descomentar solo para cambiarlas).
# HARNESS_PREFLIGHT_CHECKS=on
# HARNESS_GATE_CONCURRENCY=4
# HARNESS_KEEP_ARTIFACTS=0
# HARNESS_RETENTION_DAYS=7
# HARNESS_GATE_CACHE_REMOTE=<modulo.python>
# Caché Redis local (contenedor redis de redevent-local; `pnpm harness:cache up` lo crea). 0 = ignorarla.
# HARNESS_REDIS=1
# HARNESS_REDIS_URL=redis://127.0.0.1:56379

# Tu nombre tal como figura en ArmotuSitio; lo usa _iniciar.txt para saber quién es el responsable. Sin definir se usa el usuario autenticado del MCP.
# HARNESS_OWNER=
