{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redevent.local/harness/agents.schema.json",
  "type": "object",
  "required": ["schemaVersion", "agents"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "responsibilities",
          "allowedPaths",
          "forbiddenPaths",
          "skills",
          "contextSources",
          "inputs",
          "outputs",
          "verification",
          "tokenBudget"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbiddenPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contextSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokenBudget": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
