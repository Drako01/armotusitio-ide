{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redevent.local/harness/domains.schema.json",
  "type": "object",
  "required": ["schemaVersion", "domains"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "agent",
          "paths",
          "exclude",
          "instructions",
          "skills",
          "contextSources",
          "verification",
          "tokenBudget",
          "ownership",
          "dependencies",
          "risks",
          "securityImplications"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "disabledReason": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contextSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "tokenBudget": {
            "type": "integer",
            "minimum": 1
          },
          "ownership": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "securityImplications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
